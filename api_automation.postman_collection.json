    {
      "name": "search",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// const searchTextList= [\"Thermos - Yellow\" ,\"Thermos - Black\",\"Vase - Green\",\"Vase - Black\"];\r",
              "\r",
              "const searchTextList= [\"Thermos\" ,\"Thermos\",\"Vase\",\"Vase\"];\r",
              "// console.log(searchTextList[0]);\r",
              "function getRandomIntInclusive(min, max) {\r",
              "  const minCeiled = Math.ceil(min);\r",
              "  const maxFloored = Math.floor(max);\r",
              "  return Math.floor(Math.random() * (maxFloored - minCeiled + 1) + minCeiled);\r",
              "}\r",
              "\r",
              "console.log(getRandomIntInclusive(0,3));\r",
              "\r",
              "const index=getRandomIntInclusive(0,3);\r",
              "const searchText=searchTextList[index];\r",
              "console.log(searchText);\r",
              "pm.collectionVariables.set(\"search_text\",searchText);\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var responsebody = pm.response.json();\r",
              "\r",
              "console.log(pm.response.status);\r",
              "\r",
              "pm.test(\"validate the status code is 200\",()=>{\r",
              "    pm.expect(200).to.eql(pm.response.code);\r",
              "})\r",
              "\r",
              "const expectedsearchText= pm.collectionVariables.get(\"search_text\");\r",
              "console.log(expectedsearchText)\r",
              " const actualSearchText = responsebody.eContext.graphqlResponse.e3izd12s1b8msrmpl65.products.currentFilters[0].value;\r",
              "\r",
              "pm.test(`validate serach text is  ${expectedsearchText}  in currentFilters`,()=>{\r",
              "    pm.expect(expectedsearchText).to.eql(actualSearchText);\r",
              "})\r",
              "\r",
              "pm.test(\"validate successful entry value is true\", ()=>{\r",
              "    pm.expect(true).to.eql(responsebody.success)\r",
              "})\r",
              "\r",
              "const iteam =responsebody.eContext.graphqlResponse.e3izd12s1b8msrmpl65.products.items;\r",
              "\r",
              "\r",
              "pm.test(`validate search product contains with the string ${expectedsearchText}` , ()=>{\r",
              "    \r",
              "    let actualproduct=\"\";\r",
              "\r",
              "    for (let i=0;i<iteam.length;i++){\r",
              "        actualproduct=iteam[i].name;\r",
              "        console.log(actualproduct,expectedsearchText)\r",
              "        pm.expect(actualproduct).to.contains(expectedsearchText);\r",
              "        console.log(`Expected :  ${actualproduct} have text ${expectedsearchText}`);\r",
              "    }\r",
              "})\r",
              "\r",
              "\r",
              "const productsku = iteam[0].sku;\r",
              "pm.collectionVariables.set(\"product_sku\",productsku);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
