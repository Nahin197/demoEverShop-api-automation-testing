      "name": "addtoCarT",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "function getRandomIntInclusive(min, max) {\r",
              "  const minCeiled = Math.ceil(min);\r",
              "  const maxFloored = Math.floor(max);\r",
              "  return Math.floor(Math.random() * (maxFloored - minCeiled + 1) + minCeiled);\r",
              "}\r",
              "\r",
              " const productQty= getRandomIntInclusive(1,4);\r",
              "\r",
              "pm.collectionVariables.set(\"product_Qty\", productQty);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var responseBody = pm.response.json();",
              "",
              "pm.test(\"validate status code is 200\",()=>{",
              "",
              "    pm.expect(200).to.eql(pm.response.code);",
              "})",
              "",
              "",
              "",
              "pm.test(\"validate product sku\",()=>{",
              "",
              "    const expectedsku = pm.collectionVariables.get(\"product_sku\");",
              "    const actualsku = responseBody.data.item.product_sku;",
              "    pm.expect(expectedsku).to.eql(actualsku);",
              "",
              "})",
              "",
              "",
              "",
              "pm.test(\"validate product quantity\", ()=>{",
              "",
              "    const expectedQty = pm.collectionVariables.get(\"pre_total_qty\") + pm.collectionVariables.get(\"product_Qty\") ;",
              "    const actualQty =  responseBody.data.item.qty;",
              "    pm.expect(expectedQty).to.eql(actualQty);",
              "",
              "})",
              "",
              "const actualQty =  responseBody.data.item.qty;",
              "pm.collectionVariables.set(\"post_total_qty\", actualQty);",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
